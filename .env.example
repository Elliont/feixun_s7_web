# 生产环境变量示例：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# 全部变量都有默认值，最小可用配置就是一个空的 .env

# --- 网络 ---
# web 对外端口（默认 8080）
S7_WEB_BIND=8080
# 收秤端口（默认 30101）。改这里后，配网 App 里填的服务器端口也要改成相同值
S7_INGEST_PORT=30101
# 收秤服务绑定的宿主地址。默认 0.0.0.0（所有网卡）；只想让内网访问可填内网 IP
S7_INGEST_BIND=0.0.0.0
TZ=Asia/Shanghai

# --- 镜像 ---
# 想用自己构建的镜像就改成 feixun_s7_web:local，并按 README 用 --build
S7_IMAGE=ghcr.io/elliont/feixun_s7_web:latest

# --- 首次管理员（可选）---
# 留空：第一次打开网页会跳到 /setup，自己设用户名和密码
# 填写：启动时直接建号，不会再出现 /setup（公网部署推荐，避免被抢先注册）
#S7_ADMIN_USERNAME=admin
#S7_ADMIN_PASSWORD=换成强密码

# --- 会话签名密钥（可选）---
# 留空会自动生成并写进数据库；填了则以环境变量为准
# python -c "import secrets;print(secrets.token_urlsafe(32))"
#S7_SECRET_KEY=

# --- 高级项（一般无需修改）---
# 登录有效期（天），默认 30
#S7_SESSION_DAYS=30
# 调试日志，默认 0；置 1 打开详细日志
#S7_DEBUG=0
# HTTPS 反向代理后设为 1，给会话 cookie 加 Secure 标志；直接 http 访问请保持 0
#S7_COOKIE_SECURE=0
# 仅在可信反向代理后开启，用代理提供的客户端地址做登录限流
#S7_TRUST_PROXY=0
# 数据库文件路径，默认 $S7_DATA_DIR/s7.db
# Compose 部署时填写容器内 /data 下的路径，确保两个服务共用同一文件
#S7_DB_PATH=
# 调试用：置 1 完全跳过登录，切勿在公网开启
#S7_DEV_NOAUTH=0
