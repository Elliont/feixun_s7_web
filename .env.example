# 生产环境变量示例：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# 全部变量都有默认值，最小可用配置就是一个空的 .env

# --- 网络 ---
# web 对外端口（默认 8080）
S7_WEB_BIND=8080
# ingest 监听地址。秤会连 30101；只想让内网访问可填 192.168.1.10
S7_INGEST_BIND=0.0.0.0
TZ=Asia/Shanghai

# --- 镜像 ---
# 想用自己构建的镜像就改成 feixun_s7_web:local，并按 README 用 --build
S7_IMAGE=ghcr.io/elliont/feixun_s7_web:latest

# --- 首次管理员（可选）---
# 留空：第一次打开网页会跳到 /setup，自己设用户名和密码
# 填写：启动时直接建号，不会再出现 /setup（公网部署推荐，避免被抢先注册）
#S7_ADMIN_USERNAME=admin
#S7_ADMIN_PASSWORD=换成强密码

# --- 会话签名密钥（可选）---
# 留空会自动生成并写进数据库；填了则以环境变量为准
# python -c "import secrets;print(secrets.token_urlsafe(32))"
#S7_SECRET_KEY=
